# Local or ISBE development configuration. Never commit real private keys.
ISBE_RPC_URL=http://localhost:8545
CHAIN_ID=11073
ACCOUNT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ISBE_GOVERNANCE_ADDRESS=0xYOUR_ISBE_GOVERNANCE_ADDRESS
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS
RESERVE_RECIPIENT=0xYOUR_RESERVE_RECIPIENT
COMMISSION_RECIPIENT=0xYOUR_COMMISSION_RECIPIENT

# Optional testing configuration
DEPLOY_MOCK_TOKEN=false
TOKEN_ADDRESS=
RECIPIENT=

# Pre environment (ISBE BaaS)
PRE_RPC_URL=https://baas.pre.portal.redisbe.com/YOUR_ENDPOINT_KEY
PRE_CHAIN_ID=11073
PRE_ACCOUNT_PRIVATE_KEY=0xYOUR_PRE_ADMIN_PRIVATE_KEY
TREASURY_ROUTER_V1=
SEND_ROUTER_V1=
TREASURY_ROUTER_V2=
SEND_ROUTER_V2=
TOKENS=
RECIPIENTS=
ONLY_ROUTERS=
REMOVE=false
DRY_RUN=true

# TreasuryRouterV2 (escrow de referral)
RELEASE_EXECUTOR=
RELEASE_EXECUTOR_ENABLED=true
REFERRAL_FALLBACK_WALLET=

# Wallet generation, gas funding and pre smoke test
ROLES=
LABEL=wallets
MNEMONIC=false
TARGETS=
AMOUNT=0.0001
PRE_WALLETS_FILE=wallets/pre-roles-REPLACE_ME.json
